# ---------------------------------------------------------------------------
# Variables de entorno para SAP B1 Service Layer
# 1. Copia este archivo y renómbralo a:  .env
# 2. Llena los valores reales (sin comillas).
# NUNCA subas .env a GitHub (ya está bloqueado en .gitignore).
# ---------------------------------------------------------------------------

# URL base de la Service Layer, terminando en /b1s/v1 (sin slash final)
# Ejemplo: https://mi-servidor-sl.ejemplo.com/b1s/v1
SAP_URL=https://<HOST>/b1s/v1

# Base(s) de datos SAP (CompanyDB). Una sola, o VARIAS separadas por comas
# (una por empresa; la app usa la de la empresa seleccionada). Ejemplo:
# SAP_COMPANYDB=SBA_PROD,ERSA_PRODUCTIVA,ERSAGRO_PROD,SA_PRODUCTIVA,SB_PROD,JEUMA_PRODUCTIVA
SAP_COMPANYDB=<NOMBRE_BASE_DE_DATOS>

# Usuario y contraseña de SAP Business One (no son los de Windows)
SAP_USER=<USUARIO_SAP>
SAP_PASSWORD=<CONTRASEÑA_SAP>

# Nombre de la tabla de usuario SIN '@' (ej. FACTURAS).
# La app usa automáticamente el endpoint /U_FACTURAS de Service Layer.
SAP_UDT=FACTURAS
